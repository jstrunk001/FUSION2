# Build directories
build/
build_test/
build_test_shared/
test_output/
bin/
lib/
out/
.vs/
*.user
*.suo

# build.ps1 output -- zipped tool bundles are published to GitHub Releases,
# not committed (see README.md "Building" section)
/dist/
/archive/

# Dependencies -- deps/* (not deps/) so individual children can be
# un-ignored below; everything under deps/ is a build script's output
# (gdal_minimal, laszip_minimal, downloaded tarballs, etc.) except
# sqlite3_amalgamation, which is checked-in source.
vcpkg_installed/
vcpkg/
deps/*
!deps/sqlite3_amalgamation/
build_minimal_gdal/

# System / OS
.DS_Store
Thumbs.db

# Rendered Quarto output (regenerates from tests/R/*.qmd source)
tests/docs/
tests/fusion_evaluation_report_files/
tests/*.rmarkdown

# Rendered HTML documentation site (generated by Quarto & build.ps1)
docs/output/
docs/_site/
docs/.quarto/

# Temporary test scratch & outputs
scratch/
tile_*.tif
*.vrt
*.log
LASzip-*/


# Extra ad hoc CMake build folders (build_phase3/, etc.) and gridmetrics
# outputs written to the repo root by manual test runs
build_*/
/*_gridmetrics.tif

# RForInvt::file_version() locks <output>/_tracking.lock while it updates
# _tracking.csv; the lock is released afterwards but the empty file stays
_tracking.lock

# Typst source Quarto keeps when rendering the manual with keep-typ
docs/index.typ
